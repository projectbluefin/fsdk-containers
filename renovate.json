{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "schedule": [
    "after 2am and before 6am"
  ],
  "customManagers": [
    {
      "description": "BuildStream elements: any value annotated with a '# renovate:' comment on the preceding line. Covers `<tool>_version:` variables, `track:` pins and pinned tarball URLs.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.bst$/",
        "/^Justfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+[^\\n]*?[:=]\\s*\"?(?<currentValue>[\\w][\\w.+-]*)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions-non-major",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Upstream software pinned in BuildStream elements. Never automerge: the sha256/commit ref must be refreshed by `bst source track` (see .github/workflows/refresh-bst-refs.yml) and the image must pass `just verify` first.",
      "matchManagers": [
        "custom.regex"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "buildstream"
      ]
    },
    {
      "description": "kubectl follows the Kubernetes release cadence; skip pre-releases.",
      "matchDepNames": [
        "kubernetes/kubernetes"
      ],
      "ignoreUnstable": true
    }
  ]
}
