kind: script
description: |
  Assemble the full-OS donate-clanker VM guest disk image.

  Stages `podman-vm-filesystem.bst` at `/sysroot` (root partition content)
  and freedesktop-sdk.bst's own `vm/boot/efi.bst` at `/sysroot/efi` (EFI
  System Partition content), then aligns the staged loader entry with the
  root UUID generated for this artifact and runs the identical `genimage`-
  based GPT disk assembler
  (`vm/deploy-tools.bst` + `vm/prepare-image.bst` + `components/fakecap.bst`)
  to emit a raw disk.img. Unlike upstream's own `vm/minimal/efi.bst` (whose
  install-root *is* the raw disk.img), this element treats disk.img as a
  build-only intermediate: it is copied as a raw VM disk, which QEMU boots
  directly, and a binary SHA-256 manifest is generated beside it.

  Artifact interface: this element's
  install-root contains exactly two files —
  `donate-clanker-vm-<fsdk-version>-<arch>.raw` and
  `donate-clanker-vm-<fsdk-version>-<arch>.raw.sha256` (`sha256sum --binary`
  output for that exact file). `<fsdk-version>` is the exact pinned FSDK
  point release (e.g. "25.08.14") — the identical string the Justfile's
  `fsdk_version` (git-describe parse of `elements/freedesktop-sdk.bst`'s
  `ref:`) produces for the OCI images' labels/tags at `just export` time.
  This element has no shell access to that file from inside the sandbox,
  so rather than re-deriving it from a coarser proxy (e.g.
  `/sysroot/etc/os-release`'s `VERSION_ID`, which is only minor-branch
  precision), the Justfile's own `bst` wrapper recipe regenerates
  `include/fsdk-version.yml` from `fsdk_version` on every invocation, and
  this element's `variables:` block includes it with `(@)` — one parser
  (the Justfile's), reused, never duplicated. See
  docs/skills/vm-podman-guest/SKILL.md for the full rationale.

build-depends:
# FSDK 26.08 removed the shell from runtime-minimal, and this script element's
# commands are shell scripts, so declare the interpreter explicitly.
- freedesktop-sdk.bst:public-stacks/runtime-gnu.bst
- freedesktop-sdk.bst:components/fakecap.bst
- freedesktop-sdk.bst:vm/deploy-tools.bst
- freedesktop-sdk.bst:vm/prepare-image.bst
- podman-vm/podman-vm-initial-scripts.bst
- filename: podman-vm/podman-vm-filesystem.bst
  config:
    location: '/sysroot'
- filename: freedesktop-sdk.bst:vm/boot/efi.bst
  config:
    location: '/sysroot/efi'
# Staged out-of-root to avoid any overlap risk with vm/deploy-tools.bst's
# own glibc/runtime closure at "/" (see "Configure dependency staging
# location" in BuildStream's docs) — invoked below by full path instead of
# relying on PATH.

environment:
  E2FSPROGS_FAKE_TIME: '%{source-date-epoch}'
  LD_PRELOAD: /usr/libexec/fakecap/fakecap.so
  FAKECAP_DB: /fakecap

variables:
  # Exact pinned FSDK point release (e.g. "25.08.14"), reused verbatim from
  # the Justfile's own `fsdk_version` — see the description block above and
  # docs/skills/vm-podman-guest/SKILL.md. Never hardcode or re-derive this value
  # here; regenerated by `just bst`'s wrapper recipe before every
  # invocation, gitignored.
  (@): include/fsdk-version.yml

  # `source-date-epoch` is freedesktop-sdk.bst's own project-scoped
  # variable (its project.conf sets it to a fixed reproducible-build
  # epoch and mirrors it into the SOURCE_DATE_EPOCH environment
  # variable); it is not visible in this project. This project's own
  # BuildStream core builtin default already exports the SOURCE_DATE_EPOCH
  # *environment* variable (used unquoted by name in the genimage.cfg
  # heredoc below) with value 1321009871 — the same value is declared here
  # as a plain variable so E2FSPROGS_FAKE_TIME (a %{} substitution, not a
  # shell expansion) can reference it too, keeping both in sync.
  source-date-epoch: '1321009871'

  # Fixed namespace UUID identifying the *podman-vm artifact family*
  # (not a per-build random seed, and not by itself a full artifact
  # identity — see below). Derived once, non-secret, reproducible from
  # the command alone:
  #   uuidgen -s --namespace @url \
  #     --name "https://github.com/projectbluefin/fsdk-containers/podman-vm"
  #
  # Every UUID actually derived FROM this namespace (disk, partitions,
  # ext4 hash seed — see config.commands below) additionally folds in
  # `%{fsdk-version}` and `%{arch}` into the `--name` string passed to
  # `uuidgen -s --namespace "%{uuidnamespace}" --name "..."`. This keeps
  # rebuilds of *identical* (version, arch) inputs byte-for-byte
  # reproducible while guaranteeing distinct FSDK point releases or
  # architectures never share a disk/partition/filesystem/hash-seed UUID
  # (UUIDv5 is a deterministic hash of namespace+name: same name -> same
  # UUID, different name -> a different UUID with overwhelming
  # probability). This is independent of the VM's *runtime* identity: the
  # guest generates a fresh machine-id on first boot regardless of this
  # build-time seed.
  #
  # `prepare-image.sh --seed` is a second, distinct derivation: that script
  # treats its `--seed` value as a *namespace* of its own, deriving the
  # root filesystem UUID and EFI volume ID via
  # `uuidgen -s --namespace "${seed}" --name root|efi` internally. Passing
  # this element's own `%{uuidnamespace}` there directly would make those
  # two identities collide across every (version, arch) build the same way
  # the disk/partition UUIDs did before this fix. config.commands below
  # instead computes a per-artifact seed —
  # `uuidgen -s --namespace "%{uuidnamespace}" --name "${artifact_id}"` —
  # and passes *that* to `--seed`, so prepare-image.sh's own internal
  # root/EFI derivations inherit the full (version, arch) identity too.
  uuidnamespace: 4cff3586-cb73-555e-aad2-8e3e9a23a69c
  build-root: /genimage

  # GPT Discoverable-Partition-Spec "Linux root" type GUIDs (x86-64 /
  # arm64). Hardcoded rather than referencing freedesktop-sdk.bst's own
  # %{linux-root} (elements/include/arch.yml): that variable is scoped to
  # FSDK's own project and is not visible from this project's YAML, unlike
  # the identical heredoc inside FSDK's own vm/minimal/efi.bst, which
  # resolves it locally. Values copied verbatim from that same file.
  linux-root: 4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709
  (?):
  - arch == "aarch64":
      linux-root: B921B045-1DF0-41C3-AF44-4C6F280D3FAE

config:
  commands:
  - mkdir -p /fakecap
  - mkdir -p %{build-root}
  - |
    # `prepare-image.sh --seed` is used internally as a *namespace* (not a
    # name) for its own `uuidgen -s --namespace "${seed}" --name root|efi|salt`
    # derivations (see freedesktop-sdk.bst's files/vm/prepare-image.sh) — so
    # passing the fixed "%{uuidnamespace}" directly would make its root
    # filesystem UUID and EFI volume ID identical across every FSDK point
    # release and architecture, exactly the collision this element's other
    # UUIDs already avoid. Derive an artifact-specific seed first (folding in
    # the full identity), and pass *that* as the seed instead.
    artifact_id="donate-clanker-vm-%{fsdk-version}-%{arch}"
    artifact_seed="$(uuidgen -s --namespace "%{uuidnamespace}" --name "${artifact_id}")"
    prepare-image.sh \
       --sysroot /sysroot \
       --seed "${artifact_seed}" \
       --rootpasswd "root" > "%{build-root}/vars"

  - |
    # vm/boot/efi.bst generates its loader entry in a separate build with
    # FSDK's fixed UUID namespace. The root filesystem below is generated by
    # this element with the artifact-specific namespace, so make the boot
    # entry use the same UUID before genimage copies the EFI partition.
    . "%{build-root}/vars"
    for entry in /sysroot/efi/loader/entries/*.conf; do
      [ -f "${entry}" ] || continue
      sed -E -i \
        "s/root=UUID=[0-9A-Fa-f-]+/root=UUID=${uuid_root}/g" \
        "${entry}"
    done

  - |
    artifact_id="donate-clanker-vm-%{fsdk-version}-%{arch}"
    efi_part_uuid="$(uuidgen -s --namespace "%{uuidnamespace}" --name "${artifact_id}-partition-efi")"
    root_part_uuid="$(uuidgen -s --namespace "%{uuidnamespace}" --name "${artifact_id}-partition-root")"
    disk_uuid="$(uuidgen -s --namespace "%{uuidnamespace}" --name "${artifact_id}-disk")"
    hash_seed="$(uuidgen -s --namespace "%{uuidnamespace}" --name "${artifact_id}-hash-seed")"
    . "%{build-root}/vars"
    cat > "%{build-root}/genimage.cfg" <<EOF
    image efi.img {
        vfat {
            extraargs = "--invariant -F32 -i${id_efi} -n EFI"
        }
        mountpoint = "/efi"
        size = 105%
        temporary = true
    }
    image root.img {
        ext4  {
            label = "root"
            extraargs = "-U ${uuid_root} -E hash_seed=${hash_seed}"
            use-mke2fs = true
            fs-timestamp = "${SOURCE_DATE_EPOCH}"
        }
        size = 110%
        temporary = true
    }
    image disk.img {
        hdimage {
            align = 1M
            partition-table-type = "gpt"
            disk-uuid = "${disk_uuid}"
        }
        partition efi {
            image = "efi.img"
            partition-type-uuid = "U"
            partition-uuid = "${efi_part_uuid}"
        }
        partition root {
            image = "root.img"
            partition-type-uuid = "%{linux-root}"
            partition-uuid = "${root_part_uuid}"
        }
    }
    config {
      tmppath = "%{build-root}/tmp"
      outputpath = "%{build-root}"
    }
    EOF

  - du -h --max-depth=3 /sysroot | grep '^[^0]' | sort -rh
  - genimage --config "%{build-root}/genimage.cfg" --rootpath /sysroot
  - du -BM "%{build-root}/disk.img"

  - |
    raw_name="donate-clanker-vm-%{fsdk-version}-%{arch}.raw"
    cp "%{build-root}/disk.img" "%{install-root}/${raw_name}"
    cd "%{install-root}"
    du -BM "${raw_name}"
    sha256sum --binary "${raw_name}" > "${raw_name}.sha256"
    cat "${raw_name}.sha256"
