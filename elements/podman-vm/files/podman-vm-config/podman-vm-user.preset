# Enable the systemd --user Podman API socket for every user session.
#
# components/podman.bst's runtime-dep closure builds podman with the
# "systemd" build tag active (components/systemd-libs.bst is one of its
# plain `depends`), so podman's own `make install` (the default target,
# still run by podman.bst's make-install override alongside
# install.completions) already installs contrib/systemd/{system,user}/*
# unit files, including podman.socket, under both
# /usr/lib/systemd/system/ and /usr/lib/systemd/user/ — but ships no
# preset of its own, so nothing enables it without this file.
#
# freedesktop-sdk.bst:vm/prepare-image.bst's prepare-image.sh already runs
# `systemctl --root "$sysroot" --global preset-all` at image-assembly
# time (see vm/minimal/efi.bst / podman-vm-efi.bst). A --global preset
# writes its enablement symlink under /etc/systemd/user/, which every
# per-user `systemd --user` instance reads — so this activates
# podman.socket for the root session at first boot AND for every
# Cloud-init-created user thereafter, with no per-user provisioning step.
enable podman.socket
